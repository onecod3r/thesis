{
  "name": "@signbridge/extract",
  "version": "0.1.0",
  "exports": "./src/cli.ts",
  "tasks": {
    "extract": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env src/cli.ts",
    "check": "deno check src/*.ts",
    "fmt": "deno fmt src/",
    "lint": "deno lint src/",
    "test": "deno test --allow-read --allow-write src/"
  },
  "imports": {
    "@mediapipe/tasks-vision": "npm:@mediapipe/tasks-vision@0.10.18",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  },
  "fmt": { "lineWidth": 88 }
}
