__pycache__/
*.py[oc]
.ipynb_checkpoints/
build/
dist/
wheels/
*.egg-info
.venv
.venvs/
.env

# The data tree is NEVER committed — no exceptions, no negation rules.
# Raw datasets live in kagglehub's cache or on the POPSIGN_LANDMARKS_DRIVE,
# derived caches in data/cache/, scratch in data/temp/ (deleted after use).
data/

# The registry IS committed — run records, the index and per-run assets — but
# never the weights. It sits at the top level precisely so that committed
# artifacts do not live inside an ignored tree.
registry/**/*.pt
registry/**/export/

# model-export artifacts (TFLite chain: Keras rebuild → TFLite)
*.onnx
*.tflite
saved_model_dir/
final_saved_model/

# graphify
graphify-out/cache/
graphify-out/.graphify_*

# headroom runtime lock
.claude/.headroom_wrap_settings.lock
