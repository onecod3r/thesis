{
  // Workers Free plan (user decision 2026-09-24). Build the web app first: cd ../web && npm run build
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signbridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The browser app: HTML, JS, the 3.5 MB step model, the 14 MB Holistic model, WASM runtimes (each < 25 MiB).
  "assets": { "directory": "../web/dist", "run_worker_first": ["/api/*"] },
  // Optional: gloss -> English with an LLM. Without this binding the app uses its offline rules.
  "ai": { "binding": "AI" },
  "vars": { "LLM_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8" },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  // `npm run dev:offline`: no Workers AI binding, so no Cloudflare account is needed.
  // The app then uses its offline rules for English.
  "env": { "offline": { "vars": { "LLM_MODEL": "none" } } }
}
